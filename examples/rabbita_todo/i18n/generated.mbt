///|
fn message_id(text : I18nText) -> String {
  match text {
    Common(key) => {
      match key {
        CatalogError => "common.catalog_error"
        CatalogLoading => "common.catalog_loading"
        CatalogRetry => "common.catalog_retry"
        CurrentLanguage => "common.current_language"
        SwitchLanguage => "common.switch_language"
      }
    }
    Contract(key) => {
      match key {
        FormattedNumber(_) => "contract.formatted_number"
        LastUpdated(_) => "contract.last_updated"
      }
    }
    TodoUi(key) => {
      match key {
        ActiveCount(_) => "todo_ui.active_count"
        Add => "todo_ui.add"
        Delete => "todo_ui.delete"
        EmptyActive => "todo_ui.empty_active"
        EmptyAll => "todo_ui.empty_all"
        EmptyDone => "todo_ui.empty_done"
        EmptyStats => "todo_ui.empty_stats"
        Less => "todo_ui.less"
        MetricActive => "todo_ui.metric_active"
        MetricDone => "todo_ui.metric_done"
        MetricTotal => "todo_ui.metric_total"
        More => "todo_ui.more"
        Placeholder => "todo_ui.placeholder"
        StatusDone => "todo_ui.status_done"
        StatusOpen => "todo_ui.status_open"
        TabActive => "todo_ui.tab_active"
        TabAll => "todo_ui.tab_all"
        TabDone => "todo_ui.tab_done"
        TabStats => "todo_ui.tab_stats"
        Title => "todo_ui.title"
      }
    }
  }
}

///|
fn message_args(text : I18nText) -> Array[@runtime.MessageArg] {
  match text {
    Common(_) => []
    Contract(key) => {
      match key {
        FormattedNumber(value) => [
          { name: "value", value: @runtime.IntValue(value) },
        ]
        LastUpdated(when) => [
          { name: "when", value: @runtime.InstantMillis(when) },
        ]
      }
    }
    TodoUi(key) => {
      match key {
        ActiveCount(count) => [
