}

///|
/// Returns the configured default locale.
pub fn default_locale() -> Locale {
  EnUS
}

///|
/// Returns the configured final fallback locale.
pub fn fallback_locale() -> Locale {
  EnUS
}

///|
/// Resolves a locale code, returning `fallback` when it is unsupported.
pub fn locale_from_code(code : String, fallback : Locale) -> Locale {
  match @runtime.normalize_locale_code(code) {
    Ok(code) => {
      match code {
        "en-US" => EnUS
        "zh-CN" => ZhCN
        _ => fallback
      }
    }
    Err(_) => fallback
  }
}

