///|
/// Generated application i18n facade with installed catalogs and caches.
pub struct I18n {
  runtime : @runtime.I18n
}

///|
/// Locale-bound typed translation facade.
pub struct Translator {
  runtime : @runtime.Translator
}

///|
/// Creates the application facade and installs all embedded catalogs.
pub fn I18n::new() -> I18n {
  let runtime = @runtime.I18n::new(
    fallback_locale_code=fallback_locale().code(),
    contract_hash=CONTRACT_HASH,
    formatter=@runtime_js.formatter(),
  )
  for catalog in embedded_catalogs() {
    match runtime.install_generated_catalog(catalog) {
      Ok(_) => ()
      Err(message) => abort("invalid embedded i18n catalog: \{message}")
    }
  }
  { runtime, }
}

///|
/// Creates a translator for the configured default locale.
pub fn I18n::default_translator(self : I18n) -> Translator {
  self.translator(default_locale())
}

///|
/// Creates a translator for one supported locale.
pub fn I18n::translator(self : I18n, locale : Locale) -> Translator {
  { runtime: self.runtime.translator(locale.code()), }
}

///|
/// Resolves one external locale code and creates its translator.
pub fn I18n::translator_from_code(self : I18n, code : String) -> Translator {
  self.translator_from_codes([code])
}

///|
/// Negotiates ordered external locale codes and creates a translator.
pub fn I18n::translator_from_codes(self : I18n, codes : Array[String]) -> Translator {
  self.translator(resolve_locale_codes(codes))
}

///|
/// Negotiates ordered external locale codes against supported locales.
pub fn resolve_locale_codes(codes : Array[String]) -> Locale {
  let supported = all_locales().map(locale => locale.code())
  let resolved =
    @runtime.resolve_locale_code(codes, supported, default_locale().code())
  locale_from_code(resolved, default_locale())
}

///|
/// Validates and installs dynamic catalog-v2 JSON for a locale.
pub fn I18n::install_catalog_source(
  self : I18n,
  locale : Locale,
