///|
/// Generated application i18n facade with installed catalogs and caches.
pub struct I18n {
  runtime : @runtime.I18n
}

///|
/// Locale-bound typed translation facade.
pub struct Translator {
  runtime : @runtime.Translator
}

///|
/// Creates the application facade and installs all embedded catalogs.
pub fn I18n::new() -> I18n {
  let runtime = @runtime.I18n::new(
    fallback_locale_code=fallback_locale().code(),
    contract_hash=CONTRACT_HASH,
    profile=MESSAGE_PROFILE,
    formatter=@runtime_js.formatter(),
  )
  for catalog in embedded_catalogs() {
    match runtime.install_generated_catalog(catalog) {
      Ok(_) => ()
      Err(message) => abort("invalid embedded i18n catalog: \{message}")
    }
  }
  { runtime, }
}

///|
/// Creates a translator for the configured default locale.
pub fn I18n::default_translator(self : I18n) -> Translator {
  self.translator(default_locale())
}

///|
/// Creates a translator for one supported locale.
pub fn I18n::translator(self : I18n, locale : Locale) -> Translator {
  { runtime: self.runtime.translator(locale.code()), }
}

///|
/// Resolves one external locale code and creates its translator.
pub fn I18n::translator_from_code(self : I18n, code : String) -> Translator {
  self.translator_from_codes([code])
}

///|
/// Negotiates ordered external locale codes and creates a translator.
pub fn I18n::translator_from_codes(self : I18n, codes : Array[String]) -> Translator {
  self.translator(resolve_locale_codes(codes))
}

///|
/// Negotiates ordered external locale codes against supported locales.
pub fn resolve_locale_codes(codes : Array[String]) -> Locale {
  let supported = all_locales().map(locale => locale.code())
  let resolved =
    @runtime.resolve_locale_code(codes, supported, default_locale().code())
  locale_from_code(resolved, default_locale())
}

///|
/// Validates and installs dynamic catalog-v2 JSON for a locale.
pub fn I18n::install_catalog_source(
  self : I18n,
  locale : Locale,
  source : String,
) -> Result[Unit, String] {
  self.runtime.install_catalog_source_for(locale.code(), source)
}

///|
/// Validates and atomically installs one dynamic namespace chunk.
pub fn I18n::install_catalog_chunk_source(
  self : I18n,
  locale : Locale,
  chunk_namespace : CatalogNamespace,
  source : String,
) -> Result[Unit, String] {
  self
    .runtime
    .install_catalog_chunk_source_for(
      locale.code(),
      chunk_namespace.code(),
      source,
    )
}

///|
/// Reports whether one namespace is installed for a locale.
pub fn I18n::has_catalog_namespace(
  self : I18n,
  locale : Locale,
  chunk_namespace : CatalogNamespace,
) -> Bool {
  self.runtime.has_catalog_namespace(locale.code(), chunk_namespace.code())
}

///|
/// Reports whether every generated namespace is installed for a locale.
pub fn I18n::has_catalog(self : I18n, locale : Locale) -> Bool {
  self
    .runtime
    .has_catalog_namespaces(
      locale.code(),
      catalog_namespaces().map(value => value.code()),
    )
}

///|
/// Returns all locales whose generated namespaces are installed.
pub fn I18n::installed_locales(self : I18n) -> Array[Locale] {
  all_locales().filter(locale => self.has_catalog(locale))
}

///|
/// Drains bounded, deduplicated translation diagnostics.
pub fn I18n::take_diagnostics(self : I18n) -> @runtime.DiagnosticBatch {
  self.runtime.take_diagnostics()
}

///|
/// Returns the locale bound to this translator.
pub fn Translator::locale(self : Translator) -> Locale {
  locale_from_code(self.runtime.locale_code(), default_locale())
}

///|
fn all_locales() -> Array[Locale] {
  [EnUS, ZhCN]
}

///|
/// Strictly formats a typed text request and returns structured failures.
pub fn Translator::try_t(self : Translator, text : I18nText) -> Result[
  String,
  @runtime.TranslationError,
] {
  self.runtime.try_t(message_id(text), message_args(text))
}

///|
/// Formats a typed text request with observable fallback diagnostics.
pub fn Translator::t(self : Translator, text : I18nText) -> String {
  self.runtime.t(message_id(text), message_args(text))
}

///|
/// Strictly formats a typed rich request as structured markup parts.
pub fn Translator::try_t_parts(self : Translator, text : I18nParts) -> Result[
  Array[@runtime.MessagePart],
  @runtime.TranslationError,
] {
  self.runtime.try_t_parts(parts_message_id(text), parts_message_args(text))
}

///|
/// Formats a typed rich request with observable fallback diagnostics.
pub fn Translator::t_parts(self : Translator, text : I18nParts) -> Array[
  @runtime.MessagePart,
] {
  self.runtime.t_parts(parts_message_id(text), parts_message_args(text))
}
