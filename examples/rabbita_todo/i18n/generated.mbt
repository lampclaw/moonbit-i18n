        Add => []
        Delete => []
        EmptyActive => []
        EmptyAll => []
        EmptyDone => []
        EmptyStats => []
        Less => []
        MetricActive => []
        MetricDone => []
        MetricTotal => []
        More => []
        Placeholder => []
        StatusDone => []
        StatusOpen => []
        TabActive => []
        TabAll => []
        TabDone => []
        TabStats => []
