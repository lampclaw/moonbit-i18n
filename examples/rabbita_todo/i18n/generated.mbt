    return Some({
      locale,
      chunk_namespace,
      path: "en-US--common.json",
      sha256: "cd279985f0a3dc835e65a2b83f32bf7d9f077dba03ccbc96dd1554085a92765a",
      bytes: 485,
    })
  }
  if locale == EnUS && chunk_namespace == CatalogContract {
    return Some({
      locale,
      chunk_namespace,
      path: "en-US--contract.json",
      sha256: "1c2a6b7b82b1f57ced6742e580fe28737d6d2f91e2e482b8f73f70cc03413881",
      bytes: 464,
    })
  }
  if locale == EnUS && chunk_namespace == CatalogTodoUi {
    return Some({
      locale,
      chunk_namespace,
      path: "en-US--todo_ui.json",
      sha256: "09de8d78d808d5565d5245799e7b62221f86f17a61320efa7b444f85de91ea10",
      bytes: 1044,
    })
  }
  if locale == ZhCN && chunk_namespace == CatalogCommon {
    return Some({
      locale,
      chunk_namespace,
      path: "zh-CN--common.json",
      sha256: "20cdcbdda37bad0de6fc15435b581b1cb5906baf23e4b8ba118cac9f58a1295a",
      bytes: 480,
    })
  }
  if locale == ZhCN && chunk_namespace == CatalogContract {
    return Some({
      locale,
      chunk_namespace,
      path: "zh-CN--contract.json",
      sha256: "7bdc98a72a1c6877d0d7aa69a4495315e0005c5c7fd4e2e8c337aea6f104bec7",
      bytes: 470,
    })
  }
  if locale == ZhCN && chunk_namespace == CatalogTodoUi {
    return Some({
      locale,
      chunk_namespace,
      path: "zh-CN--todo_ui.json",
      sha256: "9345507f7a9f33d94e597a3d8cf63d0bfe0339bf373834689dbc88e4ec89f49e",
