///|
fn test_generated_marker() -> String {
  "/// Generated by lampclaw/i18n. Do not edit by hand.\n"
}

///|
async fn transaction_test_root() -> String {
  @fs.tmpdir(prefix="lampclaw-i18n-test-")
}

///|
async fn transaction_test_remove(path : String) -> Unit {
  if @fs.exists(path) {
    if @fs.kind(path, follow_symlink=false) is Directory {
      @fs.rmdir(path, recursive=true)
    } else {
      @fs.remove(path)
    }
  }
}

///|
async fn transaction_test_write_invalid_utf8(path : String) -> Unit {
  @fs.write_file(path, b"\xff", create_mode=CreateOrTruncate)
}

///|
async fn expect_cli_error(
  action : async () -> Unit raise CliError,
  fragment : String,
) -> Unit {
  try action() catch {
    CommandFailed(message) => assert_true(message.contains(fragment))
  } noraise {
    _ => fail("expected a CLI error containing: \{fragment}")
  }
}

///|
fn expect_transaction_error(
  transaction : GeneratedTransaction,
  fragment : String,
) -> Unit raise {
  try validate_transaction(transaction) catch {
    CommandFailed(message) => assert_true(message.contains(fragment))
  } noraise {
    _ => fail("expected a transaction error containing: \{fragment}")
  }
}

///|
fn test_transaction_state(
  package_dir : String,
  catalog_dir : String,
  nonce : String,
  had_package : Bool,
  had_catalogs : Bool,
) -> TransactionState {
  let transaction = GeneratedTransaction::{
    package_dir,
    catalog_dir,
    code: "",
    package_manifest: "",
    generation_manifest: "",
    catalog_names: [],
    catalog_contents: [],
  }
  let state = make_transaction_state(transaction, nonce)
  { ..state, had_package, had_catalogs }
}

///|
test "CLI finds arguments after Moon's separator" {
  assert_eq(
    user_args([
      "moon", "run", "cmd/i18n", "--", "coverage", "config.json", "schema.json",
      "locales",
    ]),
    ["coverage", "config.json", "schema.json", "locales"],
  )
}

///|
test "CLI accepts direct commands, help, and version" {
  assert_eq(user_args(["moon-i18n", "check", "--allow-partial", "config"]), [
    "check", "--allow-partial", "config",
  ])
  assert_eq(user_args(["moon-i18n", "--help"]), ["--help"])
  assert_eq(user_args(["moon-i18n", "--version"]), ["--version"])
  assert_eq(without_allow_partial(["generate", "--allow-partial", "config"]), [
    "generate", "config",
  ])
  let help = usage()
  assert_true(help.contains("moonx lampclaw/i18n/cmd/i18n@0.8.0"))
  assert_true(help.contains("scaffold <owner/module> <directory>"))
  assert_true(help.contains("<package-dir> <catalog-dir>"))
}

///|
test "CLI diagnostic rendering is stable and machine readable" {
  let diagnostic = cli_diagnostic("bad command", ["generate", "config.json"])
  assert_eq(diagnostic.code, "I18N0001")
  assert_eq(diagnostic.path, "config.json")
  let envelope = diagnostic_envelope(diagnostic)
  assert_true(
    render_cli_error(envelope, ["generate", "--diagnostic-format=json"]).contains(
      "\"diagnosticVersion\": 1",
    ),
  )
  assert_true(
    render_cli_error(envelope, ["generate"]).contains("error[I18N0001]"),
  )
}

///|
async test "scaffold creates one safe canonical bilingual module" {
  assert_true(valid_module_name("example/hello"))
  assert_false(valid_module_name("example"))
  assert_false(valid_module_name("../hello"))
  assert_false(valid_module_name("example/bad.name"))
  let root = transaction_test_root()
  let destination = path_join(root, "app")
  run_scaffold(["scaffold", "example/hello", destination])
  assert_true(file_exists(path_join(destination, "moon.mod")))
  assert_true(file_exists(path_join(destination, "i18n/generated.mbt")))
  assert_true(
    read_file(path_join(destination, "i18n/generation-manifest.json")).contains(
      "\"manifestVersion\": 1",
    ),
  )
  assert_true(file_exists(path_join(destination, "public/i18n/manifest.json")))
  assert_true(
    file_exists(path_join(destination, "public/i18n/zh-CN--common.json")),
  )
  expect_cli_error(
    () => run_scaffold(["scaffold", "example/hello", destination]),
    "refusing to overwrite existing scaffold destination",
  )
  transaction_test_remove(root)
}

///|
async test "scaffold removes locks owned only by its staging paths" {
  let root = transaction_test_root()
  let stage = path_join(root, ".app.scaffold-test")
  let lock_directory = generation_lock_directory()
  ensure_directory(lock_directory)
  let package_lock = transaction_lock_path(
    path_join(stage, "i18n"),
    lock_directory,
  )
  let catalog_lock = transaction_lock_path(
    path_join(stage, "public/i18n"),
    lock_directory,
  )
  write_file(package_lock, "")
  write_file(catalog_lock, "")
  remove_scaffold_stage_locks(stage)
  assert_false(file_exists(package_lock))
  assert_false(file_exists(catalog_lock))
  transaction_test_remove(root)
}

///|
test "generated path validation is bounded and cross-platform" {
  assert_true(valid_generated_filename("en-US.json"))
  assert_true(valid_generated_filename("zh_Hans.json"))
  assert_false(valid_generated_filename("../en.json"))
  assert_false(valid_generated_filename(".hidden.json"))
  assert_false(valid_generated_filename("en/US.json"))
  assert_false(valid_generated_filename(".json"))
  assert_false(valid_generated_filename("-en.json"))
  assert_false(valid_generated_filename("en json.json"))
  assert_true(valid_nonce("123456-0"))
  assert_false(valid_nonce("../escape"))
  assert_false(valid_nonce(""))
  assert_false(valid_nonce("x".repeat(129)))
  assert_false(valid_nonce("bad_nonce"))
  assert_true(
    is_generated_content(
      test_generated_marker() + "///|\npub fn value() -> Int { 1 }",
    ),
  )
  assert_true(
    is_generated_content(
      "// Generated by lampclaw/i18n. Do not edit by hand.\n",
    ),
  )
}

///|
test "formatted generated source has clean portable line endings" {
  let source = "///|\npub fn value() -> Int {\n  1\n}\n\n"
  let formatted = format_moonbit_source(source)
  assert_true(formatted.has_suffix("}\n"))
  assert_false(formatted.has_suffix("\n\n"))
  assert_false(formatted.contains(" \n"))
  assert_false(formatted.contains("\t\n"))
}

///|
test "generation lock state directory follows portable environment precedence" {
  let root = resolved_path("_build/lock-state")
  let environment : Map[String, String] = Map([])
  environment["LAMPCLAW_I18N_STATE_DIR"] = path_join(root, "override")
  environment["XDG_CACHE_HOME"] = path_join(root, "xdg")
  assert_eq(
    generation_lock_directory_from(environment, root),
    path_join(root, "override"),
  )
  environment["LAMPCLAW_I18N_STATE_DIR"] = " "
  assert_eq(
    generation_lock_directory_from(environment, root),
    path_join(root, "xdg/lampclaw-i18n/locks"),
  )
  environment.remove("XDG_CACHE_HOME")
  environment["LOCALAPPDATA"] = path_join(root, "windows")
  assert_eq(
    generation_lock_directory_from(environment, root),
    path_join(root, "windows/lampclaw/i18n/locks"),
  )
  environment.remove("LOCALAPPDATA")
  environment["USERPROFILE"] = path_join(root, "profile")
  assert_eq(
    generation_lock_directory_from(environment, root),
    path_join(root, "profile/.cache/lampclaw-i18n/locks"),
  )
  environment.remove("USERPROFILE")
  environment["TEMP"] = path_join(root, "temporary")
  assert_eq(
    generation_lock_directory_from(environment, root),
    path_join(root, "temporary/lampclaw-i18n/locks"),
  )
  environment.remove("TEMP")
  assert_eq(
    generation_lock_directory_from(environment, root),
    path_join(root, ".lampclaw-i18n-locks"),
  )
}

///|
test "transaction path and artifact validation rejects unsafe inputs" {
  let root = resolved_path("_build/transaction-validation")
  let package_dir = path_join(root, "package")
  let catalog_dir = path_join(path_join(root, "public"), "catalogs")
  assert_true(path_contains(root, root))
  assert_true(path_contains(root, package_dir))
  assert_false(path_contains(package_dir, root))
  let lock_directory = path_join(root, "state")
  let package_lock = transaction_lock_path(package_dir, lock_directory)
  let catalog_lock = transaction_lock_path(catalog_dir, lock_directory)
  assert_eq(package_lock, transaction_lock_path(package_dir, lock_directory))
  assert_true(path_contains(lock_directory, package_lock))
  assert_true(path_contains(lock_directory, catalog_lock))
  assert_true(package_lock.has_suffix(".lampclaw.lock"))
  assert_false(package_lock == catalog_lock)
  assert_eq(
    transaction_nonce(
      path_join(root, ".package.stage-safe-1"),
      package_dir,
      "stage",
    ),
    Some("safe-1"),
  )
  assert_eq(
    transaction_nonce(path_join(root, "wrong"), package_dir, "stage"),
    None,
  )
  assert_eq(
    transaction_nonce(
      path_join(root, ".package.stage-bad_nonce"),
      package_dir,
      "stage",
    ),
    None,
  )
  expect_transaction_error(
    GeneratedTransaction::{
      package_dir,
      catalog_dir: path_join(package_dir, "catalogs"),
      code: "",
      package_manifest: "",
      generation_manifest: "",
      catalog_names: [],
      catalog_contents: [],
    },
    "distinct dedicated directories",
  )
  expect_transaction_error(
    GeneratedTransaction::{
      package_dir,
      catalog_dir,
      code: "",
      package_manifest: "",
      generation_manifest: "",
      catalog_names: ["en-US.json"],
      catalog_contents: [],
    },
    "different lengths",
  )
  expect_transaction_error(
    GeneratedTransaction::{
      package_dir,
      catalog_dir,
      code: "",
      package_manifest: "",
      generation_manifest: "",
      catalog_names: ["../escape.json"],
      catalog_contents: ["{}"],
    },
    "invalid generated catalog filename",
  )
  expect_transaction_error(
    GeneratedTransaction::{
      package_dir,
      catalog_dir,
      code: "",
      package_manifest: "",
      generation_manifest: "",
      catalog_names: ["en.json", "en.json"],
      catalog_contents: ["{}", "{}"],
    },
    "invalid generated catalog filename",
  )
}

///|
async test "generation transaction owns outputs and removes stale catalogs" {
  let root = transaction_test_root()
  let package_dir = path_join(root, "package")
  let catalog_dir = path_join(root, "catalogs")
  let marker = test_generated_marker()
  write_generated_transaction(
    package_dir,
    catalog_dir,
    marker + "///|\npub fn value() -> Int { 1 }\n",
    marker + "import {}\n",
    ["en-US.json", "fr.json"],
    ["en", "fr"],
  )
  assert_true(file_exists(path_join(package_dir, ".lampclaw-i18n.json")))
  assert_true(file_exists(path_join(catalog_dir, "fr.json")))
  write_generated_transaction(
    package_dir,
    catalog_dir,
    marker + "///|\npub fn value() -> Int { 2 }\n",
    marker + "import {}\n",
    ["en-US.json"],
    ["en-v2"],
  )
  assert_false(file_exists(path_join(catalog_dir, "fr.json")))
  assert_true(read_file(path_join(package_dir, "generated.mbt")).contains("2"))
  write_file(path_join(package_dir, "custom.mbt"), "user-owned")
  try
    write_generated_transaction(
      package_dir,
      catalog_dir,
      marker + "///|\npub fn value() -> Int { 3 }\n",
      marker + "import {}\n",
      ["en-US.json"],
      ["en-v3"],
    )
  catch {
    CommandFailed(message) =>
      if !(message.contains("unowned file") ||
        message.contains("invalid generated artifact")) {
        fail("unexpected recovery error: \{message}")
      }
  } noraise {
    _ => fail("transaction must reject user-owned files")
  }
  transaction_test_remove(root)
}

///|
async test "unchanged generation is a true no-op" {
  let root = transaction_test_root()
  let package_dir = path_join(root, "package")
  let catalog_dir = path_join(root, "catalogs")
  let marker = test_generated_marker()
  let code = marker + "///|\npub fn value() -> Int { 1 }\n"
  let package_manifest = marker + "import {}\n"
  let generation_manifest = "{\"manifestVersion\":1}\n"
  write_generated_transaction(
    package_dir,
    catalog_dir,
    code,
    package_manifest,
    ["en-US.json"],
    ["en"],
    generation_manifest~,
  )
  let interface_path = path_join(package_dir, "pkg.generated.mbti")
  write_file(interface_path, "interface-marker")
  write_generated_transaction(
    package_dir,
    catalog_dir,
    code,
    package_manifest,
    ["en-US.json"],
    ["en"],
    generation_manifest~,
  )
  assert_eq(read_file(interface_path), "interface-marker")
  assert_eq(
    read_file(path_join(package_dir, "generation-manifest.json")),
    generation_manifest,
  )
  transaction_test_remove(root)
}

///|
async test "generation safely adopts recognized legacy outputs" {
  let root = transaction_test_root()
  let package_dir = path_join(root, "package")
  let catalog_dir = path_join(root, "catalogs")
  @fs.mkdir(package_dir)
  @fs.mkdir(catalog_dir)
  write_file(
    path_join(package_dir, "generated.mbt"),
    test_generated_marker() + "///|\npub fn value() -> Int { 1 }\n",
  )
  write_file(
    path_join(package_dir, "moon.pkg"),
    "// Generated by lampclaw/i18n. Do not edit by hand.\n",
  )
  write_file(
    path_join(catalog_dir, "en-US.json"),
    "{\"catalogVersion\":2,\"contractHash\":\"legacy\"}",
  )
  write_generated_transaction(
    package_dir,
    catalog_dir,
    test_generated_marker() + "///|\npub fn value() -> Int { 2 }\n",
    test_generated_marker() + "import {}\n",
    ["en-US.json"],
    ["new"],
  )
  assert_true(file_exists(path_join(package_dir, ".lampclaw-i18n.json")))
  assert_true(file_exists(path_join(catalog_dir, ".lampclaw-i18n.json")))
  assert_eq(read_file(path_join(catalog_dir, "en-US.json")), "new")
  transaction_test_remove(root)
}

///|
async test "generation rejects malformed ownership and unrecognized legacy data" {
  let root = transaction_test_root()
  let package_dir = path_join(root, "package")
  let catalog_dir = path_join(root, "catalogs")
  @fs.mkdir(package_dir)
  write_file(path_join(package_dir, ".lampclaw-i18n.json"), "not-json")
  expect_cli_error(
    () => verify_generated_directory(package_dir, "package"),
    "invalid generated-directory ownership manifest",
  )
  transaction_test_remove(package_dir)
  @fs.mkdir(package_dir)
  write_file(path_join(package_dir, "generated.mbt"), test_generated_marker())
  write_file(path_join(package_dir, "moon.pkg"), test_generated_marker())
  write_file(
    path_join(package_dir, "generation-manifest.json"),
    "{\"manifestVersion\":1,\"generator\":\"someone/else\"}",
  )
  expect_cli_error(
    () => verify_generated_directory(package_dir, "package"),
    "refusing to overwrite unowned i18n file",
  )
  transaction_test_remove(package_dir)
  @fs.mkdir(package_dir)
  write_file(path_join(package_dir, "generated.mbt"), "user-owned")
  expect_cli_error(
    () => verify_generated_directory(package_dir, "package"),
    "refusing to overwrite unowned i18n file",
  )
  @fs.mkdir(catalog_dir)
  write_file(path_join(catalog_dir, "en-US.json"), "not-a-catalog")
  expect_cli_error(
    () => verify_generated_directory(catalog_dir, "catalogs"),
    "refusing to adopt non-catalog file",
  )
  transaction_test_remove(root)
}

///|
async test "crash recovery restores the directory that was backed up" {
  let root = transaction_test_root()
  let package_dir = resolved_path(path_join(root, "package"))
  let catalog_dir = resolved_path(path_join(root, "catalogs"))
  let marker = test_generated_marker()
  write_generated_transaction(
    package_dir,
    catalog_dir,
    marker + "///|\npub fn value() -> Int { 1 }\n",
    marker + "import {}\n",
    ["en-US.json"],
    ["first"],
  )
  let sentinel = path_join(catalog_dir, "user-owned.txt")
  write_file(sentinel, "must survive recovery")
  let state = test_transaction_state(
    package_dir, catalog_dir, "recovery-1", true, true,
  )
  @fs.mkdir(state.package_stage)
  @fs.mkdir(state.catalog_stage)
  @fs.rename(package_dir, state.package_backup, replace=false)
  let journal = transaction_journal(package_dir)
  write_file(journal, transaction_state_json(state))
  try
    write_generated_transaction(
      package_dir,
      catalog_dir,
      marker + "///|\npub fn value() -> Int { 2 }\n",
      marker + "import {}\n",
      ["en-US.json"],
      ["second"],
    )
  catch {
    CommandFailed(message) =>
      if !(message.contains("unowned file") ||
        message.contains("invalid generated artifact")) {
        fail("unexpected recovery error: \{message}")
      }
  } noraise {
    _ => fail("unowned catalog sentinel must block replacement")
  }
  assert_eq(read_file(sentinel), "must survive recovery")
  assert_true(read_file(path_join(package_dir, "generated.mbt")).contains("1"))
  assert_false(file_exists(journal))
  transaction_test_remove(root)
}

///|
async test "journal validation accepts v1 and v2 but rejects escaping paths" {
  let root = transaction_test_root()
  let package_dir = resolved_path(path_join(root, "package"))
  let catalog_dir = resolved_path(path_join(root, "catalogs"))
  let state = test_transaction_state(
    package_dir, catalog_dir, "compat-1", false, false,
  )
  let v2 = transaction_state_json(state)
  assert_eq(
    parse_transaction_state(v2, package_dir, catalog_dir).package_dir,
    package_dir,
  )
  let v1 = v2.replace(old="\"version\": 2", new="\"version\": 1")
  assert_eq(
    parse_transaction_state(v1, package_dir, catalog_dir).catalog_dir,
    catalog_dir,
  )
  let escaped = transaction_state_json({
    ..state,
    package_stage: resolved_path(path_join(root, "../escape")),
  })
  try parse_transaction_state(escaped, package_dir, catalog_dir) catch {
    CommandFailed(message) => assert_true(message.contains("invalid"))
  } noraise {
    _ => fail("journal paths outside staging parents must be rejected")
  }
  try parse_transaction_state("not-json", package_dir, catalog_dir) catch {
    CommandFailed(message) => assert_true(message.contains("invalid"))
  } noraise {
    _ => fail("malformed journals must be rejected")
  }
  transaction_test_remove(root)
}

///|
async test "recovery removes incomplete outputs that had no predecessor" {
  let root = transaction_test_root()
  let package_dir = resolved_path(path_join(root, "package"))
  let catalog_dir = resolved_path(path_join(root, "catalogs"))
  let state = test_transaction_state(
    package_dir, catalog_dir, "new-output-1", false, false,
  )
  @fs.mkdir(package_dir)
  @fs.mkdir(catalog_dir)
  @fs.mkdir(state.package_stage)
  @fs.mkdir(state.catalog_stage)
  let journal = transaction_journal(package_dir)
  write_file(journal, transaction_state_json(state))
  assert_false(settle_transaction(state, journal))
  assert_false(file_exists(package_dir))
  assert_false(file_exists(catalog_dir))
  assert_false(file_exists(journal))
  transaction_test_remove(root)
}

///|
async test "generation lock rejects a second writer" {
  let root = transaction_test_root()
  let lock_path = path_join(root, ".output.lampclaw.lock")
  let first = open_generation_lock(lock_path)
  try open_generation_lock(lock_path) catch {
    CommandFailed(message) => assert_true(message.contains("another i18n"))
  } noraise {
    second => {
      second.unlock()
      second.close()
      fail("a second writer must not acquire the same lock")
    }
  }
  first.unlock()
  first.close()
  transaction_test_remove(root)
}

///|
async test "shared state directory creation is idempotent" {
  let root = transaction_test_root()
  let directory = path_join(root, "state/locks")
  @async.with_task_group() <| group => {
    for index = 0; index < 8; index = index + 1 {
      group.spawn_bg(() => ensure_directory(directory))
    }
  }
  assert_true(file_kind(directory) is Directory)
  transaction_test_remove(root)
}

///|
async test "CLI generation and tooling integrate on the portable filesystem" {
  let root = transaction_test_root()
  let config = "examples/rabbita_todo/localization/config.json"
  let schema = "examples/rabbita_todo/localization/schema.json"
  let locales = "examples/rabbita_todo/localization/locales"
  let source = path_join(locales, "en-US.json")
  let target = path_join(locales, "zh-CN.json")
  let package_dir = path_join(root, "package")
  let catalog_dir = path_join(root, "catalogs")
  run_command(["generate", config, schema, locales, package_dir, catalog_dir])
  assert_true(file_exists(path_join(package_dir, "generated.mbt")))
  assert_true(file_exists(path_join(catalog_dir, "manifest.json")))
  assert_true(file_exists(path_join(catalog_dir, "en-US--common.json")))
  assert_true(file_exists(path_join(catalog_dir, "zh-CN--todo_ui.json")))
  run_command(["check", config, schema, locales, package_dir, catalog_dir])
  run_command(["coverage", config, schema, locales])
  let pseudo_file = path_join(root, "en-XA.json")
  run_command([
    "pseudo",
    "--message-profile",
    @runtime.MF2_STANDARD_MESSAGE_PROFILE,
    schema,
    "en-US",
    source,
    "en-XA",
    pseudo_file,
  ])
  assert_true(read_file(pseudo_file).contains("["))
  let xliff_file = path_join(root, "messages.xlf")
  run_command([
    "export-xliff",
    "--message-profile",
    @runtime.MF2_STANDARD_MESSAGE_PROFILE,
    schema,
    "en-US",
    source,
    "zh-CN",
    target,
    xliff_file,
  ])
  assert_true(read_file(xliff_file).contains("version=\"2.1\""))
  let imported_file = path_join(root, "imported.json")
  let state_file = path_join(root, "exchange-state.json")
  let report_file = path_join(root, "xliff-report.json")
  run_command([
    "import-xliff",
    "--message-profile",
    @runtime.MF2_STANDARD_MESSAGE_PROFILE,
    "--state-output",
    state_file,
    "--report-output",
    report_file,
    schema,
    "en-US",
    source,
    "zh-CN",
    xliff_file,
    imported_file,
  ])
  assert_true(read_file(imported_file).contains("todo_ui"))
  assert_true(read_file(state_file).contains("sourceSha256"))
  assert_true(read_file(report_file).contains("xliff-import"))
  let default_imported_file = path_join(root, "default-imported.json")
  run_command([
    "import-xliff",
    "--message-profile",
    @runtime.MF2_STANDARD_MESSAGE_PROFILE,
    schema,
    "en-US",
    source,
    "zh-CN",
    xliff_file,
    default_imported_file,
  ])
  assert_true(file_exists(default_imported_file + ".xliff-state.json"))
  assert_true(file_exists(default_imported_file + ".xliff-report.json"))
  let roundtrip_xliff = path_join(root, "roundtrip.xlf")
  run_command([
    "export-xliff",
    "--message-profile",
    @runtime.MF2_STANDARD_MESSAGE_PROFILE,
    "--state",
    state_file,
    schema,
    "en-US",
    source,
    "zh-CN",
    imported_file,
    roundtrip_xliff,
  ])
  assert_true(read_file(roundtrip_xliff).contains("segment id=\"s1\""))
  let i18next_output = path_join(root, "i18next.json")
  let i18next_report = path_join(root, "i18next-report.json")
  run_command([
    "import-i18next",
    "--message-profile",
    @runtime.MF2_STANDARD_MESSAGE_PROFILE,
    schema,
    "zh-CN",
    target,
    i18next_output,
    i18next_report,
  ])
  assert_true(read_file(i18next_output).contains("todo_ui"))
  assert_true(read_file(i18next_report).contains("i18next-import"))
  let migration_schema = path_join(root, "migration-schema.json")
  let arb_input = path_join(root, "input.arb")
  let arb_output = path_join(root, "arb.json")
  let arb_report = path_join(root, "arb-report.json")
  write_file(
    migration_schema, "{ \"messages\": { \"common\": [\"welcome\"] }, \"params\": { \"common.welcome\": [{ \"name\": \"name\", \"type\": \"String\" }] } }",
  )
  write_file(
    arb_input, "{ \"@@locale\": \"fr\", \"welcome\": \"Bonjour {name}\" }",
  )
  run_command([
    "import-arb",
    "--message-profile",
    @runtime.MF2_STANDARD_MESSAGE_PROFILE,
    migration_schema,
    "fr",
    arb_input,
    arb_output,
    arb_report,
  ])
  assert_true(read_file(arb_output).contains("Bonjour {$name}"))
  assert_true(read_file(arb_report).contains("arb-import"))
  transaction_test_remove(root)
}

///|
async test "CLI source discovery enforces aggregate and strict UTF-8 limits" {
  let root = transaction_test_root()
  write_file(path_join(root, "config.json"), "{}")
  write_file(path_join(root, "schema.json"), "{}")
  write_file(path_join(root, "notes.txt"), "ignored")
  write_file(path_join(root, "en_US.json"), "{\"common\":{}}")
  let sources = locale_sources(root)
  assert_eq(sources.length(), 1)
  assert_eq(sources[0].code, "en_US")
  try locale_sources_with_limit(root, 1) catch {
    CommandFailed(message) => assert_true(message.contains("aggregate UTF-8"))
  } noraise {
    _ => fail("aggregate locale source overflow must fail")
  }
  let oversized = path_join(root, "oversized.txt")
  write_file(oversized, "two bytes")
  try read_file_limited(oversized, 1) catch {
    CommandFailed(message) => assert_true(message.contains("1-byte limit"))
  } noraise {
    _ => fail("oversized files must be rejected before decoding")
  }
  let invalid_utf8 = path_join(root, "invalid-utf8.txt")
  transaction_test_write_invalid_utf8(invalid_utf8)
  try read_file(invalid_utf8) catch {
    CommandFailed(message) =>
      assert_true(message.contains("UTF-8 encoded data"))
  } noraise {
    _ => fail("invalid UTF-8 input must fail")
  }
  assert_eq(text_file_content("value"), "value\n")
  assert_eq(text_file_content("value\n"), "value\n")
  expect_cli_error(
    () => ignore(read_file_limited(oversized, -1)),
    "negative byte limit",
  )
  let directory = path_join(root, "directory")
  @fs.mkdir(directory)
  expect_cli_error(
    () => ignore(read_file_limited(directory, 100)),
    "not a regular file",
  )
  expect_cli_error(() => ignore(read_dir(oversized)), "not a directory")
  transaction_test_remove(root)
}

///|
async test "CLI rejects incomplete commands before I/O" {
  async fn expect_error(action : async () -> Unit raise CliError) -> Unit {
    try action() catch {
      CommandFailed(_) => ()
    } noraise {
      _ => fail("expected a CLI error")
    }
  }
  expect_error(() => run_generate(["generate"], false))
  expect_error(() => run_coverage(["coverage"]))
  expect_error(() => run_pseudo(["pseudo"]))
  expect_error(() => run_export_xliff(["export-xliff"]))
  expect_error(() => run_import_xliff(["import-xliff"]))
  expect_error(() => run_import_i18next(["import-i18next"]))
  expect_error(() => run_import_arb(["import-arb"]))
  expect_error(() => run_command([]))
  expect_error(() => run_command(["unknown"]))
  run_command(["help"])
  run_command(["--version"])
}
