///|
test "CLI finds arguments after Moon's separator" {
  assert_eq(
    user_args([
      "moon", "run", "cmd/i18n", "--", "coverage", "config.json", "schema.json",
      "locales",
    ]),
    ["coverage", "config.json", "schema.json", "locales"],
  )
}

///|
test "CLI accepts direct command arguments" {
  assert_eq(
    user_args(["node", "i18n.js", "check", "--allow-partial", "config"]),
    ["check", "--allow-partial", "config"],
  )
  assert_eq(without_allow_partial(["generate", "--allow-partial", "config"]), [
    "generate", "config",
  ])
}

///|
test "CLI usage documents explicit input and output paths" {
  let help = usage()
  assert_true(help.contains("<config-file> <schema-file> <locale-dir>"))
  assert_true(help.contains("<package-dir> <catalog-dir>"))
}

///|
test "generated package ownership accepts only its managed source" {
  assert_true(
    is_generated_content(
      "// Generated by lampclaw/i18n. Do not edit by hand.\nimport {}",
    ),
  )
  assert_false(is_generated_content("import {}"))
  assert_eq(
    unexpected_moonbit_source([
      "generated.mbt", "moon.pkg", "pkg.generated.mbti",
    ]),
    None,
  )
  assert_eq(
    unexpected_moonbit_source(["generated.mbt", "custom.mbt"]),
    Some("custom.mbt"),
  )
}
