  // bidi 23: name       = [bidi] name-start *name-char [bidi]
  let result_53 = format_mf2_with_provider(
    ".local $‎foo‏ = {3} {{{$‎foo‏}}}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_53.value, "⁨3⁩")
  assert_eq(result_53.errors.map(error => error.code), [])
  // bidi 24: name       = [bidi] name-start *name-char [bidi]
  let result_54 = format_mf2_with_provider(
    ".local $foo = {4} {{{$‎foo‏}}}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_54.value, "⁨4⁩")
  assert_eq(result_54.errors.map(error => error.code), [])
  // bidi 25: name       = [bidi] name-start *name-char [bidi]
  let result_55 = format_mf2_with_provider(
    ".local $‎foo‏ = {5} {{{$foo}}}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_55.value, "⁨5⁩")
  assert_eq(result_55.errors.map(error => error.code), [])
  // bidi 26: name       = [bidi] name-start *name-char [bidi]
  let result_56 = format_mf2_with_provider(
    ".local $foo‎bar = {5} {{{$foo‎bar}}}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_56.errors.map(error => error.code), [Mf2SyntaxCode])
  // u-options 0: u: Options
  let result_57 = format_mf2_with_provider(
    "{#tag u:id=x}content{/ns:tag u:id=x}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_57.value, "content")
  assert_eq(result_57.errors.map(error => error.code), [])
  assert_eq(mf2_fixture_part_signatures(result_57.parts), [
    "markup|open|" + mf2_fixture_field("tag") + "|" + mf2_fixture_field("x"),
    "text|" + mf2_fixture_field("content"),
    "markup|close|" + mf2_fixture_field("ns:tag") + "|" + mf2_fixture_field("x"),
  ])
  // u-options 1: u: Options
  let result_58 = format_mf2_with_provider(
    "{#tag u:dir=rtl}content{/ns:tag}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_58.value, "content")
  assert_eq(result_58.errors.map(error => error.code), [Mf2BadOptionCode])
  assert_eq(mf2_fixture_part_signatures(result_58.parts), [
    "markup|open|" + mf2_fixture_field("tag") + "|" + mf2_fixture_field(""),
    "text|" + mf2_fixture_field("content"),
    "markup|close|" + mf2_fixture_field("ns:tag") + "|" + mf2_fixture_field(""),
  ])
  // u-options 2: u: Options
  let result_59 = format_mf2_with_provider(
    "hello {world :string u:dir=ltr u:id=foo}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_59.value, "hello ⁦world⁩")
  assert_eq(result_59.errors.map(error => error.code), [])
  assert_eq(mf2_fixture_part_signatures(result_59.parts), [
    "text|" + mf2_fixture_field("hello "),
    "bidi|" + mf2_fixture_field("⁦"),
    "expression|" +
    mf2_fixture_field("string") +
    "|ltr|" +
    mf2_fixture_field("foo") +
    "|" +
    mf2_fixture_field("world"),
    "bidi|" + mf2_fixture_field("⁩"),
  ])
  // u-options 3: u: Options
  let result_60 = format_mf2_with_provider(
    "hello {world :string u:dir=rtl}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_60.value, "hello ⁧world⁩")
  assert_eq(result_60.errors.map(error => error.code), [])
  assert_eq(mf2_fixture_part_signatures(result_60.parts), [
    "text|" + mf2_fixture_field("hello "),
    "bidi|" + mf2_fixture_field("⁧"),
    "expression|" +
    mf2_fixture_field("string") +
    "|rtl|" +
    mf2_fixture_field("") +
    "|" +
    mf2_fixture_field("world"),
    "bidi|" + mf2_fixture_field("⁩"),
  ])
  // u-options 4: u: Options
  let result_61 = format_mf2_with_provider(
    "hello {world :string u:dir=auto}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_61.value, "hello ⁨world⁩")
  assert_eq(result_61.errors.map(error => error.code), [])
  assert_eq(mf2_fixture_part_signatures(result_61.parts), [
    "text|" + mf2_fixture_field("hello "),
    "bidi|" + mf2_fixture_field("⁨"),
    "expression|" +
    mf2_fixture_field("string") +
    "|unknown|" +
    mf2_fixture_field("") +
    "|" +
    mf2_fixture_field("world"),
    "bidi|" + mf2_fixture_field("⁩"),
  ])
  // u-options 5: u: Options
  let result_62 = format_mf2_with_provider(
    ".local $world = {world :string u:dir=ltr u:id=foo} {{hello {$world}}}",
    mf2_fixture_context("en-US", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_62.value, "hello ⁦world⁩")
  assert_eq(result_62.errors.map(error => error.code), [])
  assert_eq(mf2_fixture_part_signatures(result_62.parts), [
    "text|" + mf2_fixture_field("hello "),
    "bidi|" + mf2_fixture_field("⁦"),
    "expression|" +
    mf2_fixture_field("string") +
    "|ltr|" +
    mf2_fixture_field("foo") +
    "|" +
    mf2_fixture_field("world"),
    "bidi|" + mf2_fixture_field("⁩"),
  ])
  // u-options 6: u: Options
  let result_63 = format_mf2_with_provider(
    "أهلاً {بالعالم :string u:dir=rtl}",
    mf2_fixture_context("ar", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_63.value, "أهلاً ⁧بالعالم⁩")
  assert_eq(result_63.errors.map(error => error.code), [])
  // u-options 7: u: Options
  let result_64 = format_mf2_with_provider(
    "أهلاً {بالعالم :string u:dir=auto}",
    mf2_fixture_context("ar", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_64.value, "أهلاً ⁨بالعالم⁩")
  assert_eq(result_64.errors.map(error => error.code), [])
  // u-options 8: u: Options
  let result_65 = format_mf2_with_provider(
    "أهلاً {world :string u:dir=ltr}",
    mf2_fixture_context("ar", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_65.value, "أهلاً ⁦world⁩")
  assert_eq(result_65.errors.map(error => error.code), [])
  // u-options 9: u: Options
  let result_66 = format_mf2_with_provider(
    "أهلاً {بالعالم :string}",
    mf2_fixture_context("ar", [], Mf2DefaultBidiIsolation),
    mf2_test_provider(),
  )
  assert_eq(result_66.value, "أهلاً ⁨بالعالم⁩")
  assert_eq(result_66.errors.map(error => error.code), [])
}
