///|
/// Renders deterministic typed MoonBit bindings for validated inputs.
pub fn generate_bindings(
  config : I18nConfig,
  schema : Schema,
  locales : Array[LocaleResource],
  contract_hash : String,
) -> String {
  let out = StringBuilder::new()
  out.write_string(
    "///|\n/// Generated by lampclaw/i18n. Do not edit by hand.\n/// SHA-256 contract hash shared by the generated bindings and catalogs.\npub const CONTRACT_HASH : String = \"\{escape_text(contract_hash)}\"\n\n",
  )
  write_locale_enum(out, config)
  let texts = schema.entries.filter(entry => {
    !schema_is_parts(schema, message_id(entry))
  })
  let parts = schema.entries.filter(entry => {
    schema_is_parts(schema, message_id(entry))
  })
  if !texts.is_empty() {
    write_i18n_text_enum(out, texts)
    for group in groups(texts) {
      write_group_enum(out, group, entries_for(texts, group), schema)
    }
    write_message_id(out, texts)
    write_message_args(out, texts)
  }
  if !parts.is_empty() {
    write_i18n_parts_enum(out, parts)
    for group in groups(parts) {
      write_parts_group_enum(out, group, entries_for(parts, group), schema)
    }
    write_parts_message_id(out, parts)
    write_parts_message_args(out, parts)
  }
  write_embedded_catalogs(out, config, locales)
  write_facade(out, config, !texts.is_empty(), !parts.is_empty())
  out.to_string()
}

///|
/// Returns the manifest used by generated JavaScript facade packages.
pub fn generated_package_manifest() -> String {
  let manifest =
    #|// Generated by lampclaw/i18n. Do not edit by hand.
    #|
    #|import {
    #|  "lampclaw/i18n/runtime",
    #|  "lampclaw/i18n/runtime/js" @runtime_js,
    #|}
    #|
    #|supported_targets = "js"
    #|
    #|formatter(ignore: [ "generated.mbt" ])
  manifest
}

///|
fn write_locale_enum(out : StringBuilder, config : I18nConfig) -> Unit {
  out.write_string(
    "///|\n/// A locale supported by this generated application binding.\npub(all) enum Locale {\n",
  )
  for locale in config.locales {
    out.write_string(
      "  /// Locale `\{locale.code}`.\n  \{locale_variant(locale.code)}\n",
    )
  }
  out.write_string("} derive(Eq, Debug)\n\n")
  out.write_string(
    "///|\n/// Returns this locale's normalized BCP 47 code.\npub fn Locale::code(self : Locale) -> String {\n  match self {\n",
  )
  for locale in config.locales {
    out.write_string(
      "    \{locale_variant(locale.code)} => \"\{locale.code}\"\n",
    )
  }
  out.write_string("  }\n}\n\n")
  out.write_string(
    "///|\n/// Returns the value to use for an HTML `lang` attribute.\npub fn Locale::html_lang(self : Locale) -> String { self.code() }\n\n",
  )
  out.write_string(
    "///|\n/// Returns `ltr` or `rtl` for this locale.\npub fn Locale::direction(self : Locale) -> String {\n  match self {\n",
  )
  for locale in config.locales {
    out.write_string(
      "    \{locale_variant(locale.code)} => \"\{locale.direction}\"\n",
    )
  }
  out.write_string("  }\n}\n\n")
  out.write_string(
    "///|\n/// Returns the configured default locale.\npub fn default_locale() -> Locale { \{locale_variant(config.default_locale)} }\n\n",
  )
  out.write_string(
    "///|\n/// Returns the configured final fallback locale.\npub fn fallback_locale() -> Locale { \{locale_variant(config.fallback_locale)} }\n\n",
  )
  out.write_string(
    "///|\n/// Resolves a locale code, returning `fallback` when it is unsupported.\npub fn locale_from_code(code : String, fallback : Locale) -> Locale {\n",
  )
  out.write_string(
    "  match @runtime.normalize_locale_code(code) {\n    Ok(code) => match code {\n",
  )
  for locale in config.locales {
    out.write_string(
      "      \"\{locale.code}\" => \{locale_variant(locale.code)}\n",
    )
  }
  out.write_string(
    "      _ => fallback\n    }\n    Err(_) => fallback\n  }\n}\n\n",
  )
}

///|
fn write_i18n_text_enum(out : StringBuilder, entries : Array[Entry]) -> Unit {
  out.write_string(
    "///|\n/// A type-safe text message request.\npub(all) enum I18nText {\n",
  )
  for group in groups(entries) {
    let type_name = pascal(group)
    out.write_string(
      "  /// A message in the `\{group}` group.\n  \{type_name}(\{type_name}Text)\n",
    )
  }
  out.write_string("} derive(Eq, Debug)\n\n")
}

///|
fn write_group_enum(
  out : StringBuilder,
  group : String,
  entries : Array[Entry],
  schema : Schema,
) -> Unit {
  out.write_string(
    "///|\n/// Text messages in the `\{group}` group.\npub(all) enum \{pascal(group)}Text {\n",
  )
  for entry in entries {
    write_entry_doc(out, schema, entry)
    out.write_string("  \{pascal(entry.key)}")
    if !entry.params.is_empty() {
      out.write_string("(\{join_param_types(entry.params)})")
    }
    out.write_string("\n")
  }
  out.write_string("} derive(Eq, Debug)\n\n")
}

///|
fn write_i18n_parts_enum(out : StringBuilder, entries : Array[Entry]) -> Unit {
  out.write_string(
    "///|\n/// A type-safe rich-message request.\npub(all) enum I18nParts {\n",
  )
  for group in groups(entries) {
    let type_name = pascal(group)
    out.write_string(
      "  /// A rich message in the `\{group}` group.\n  \{type_name}(\{type_name}Parts)\n",
    )
  }
  out.write_string("} derive(Eq, Debug)\n\n")
}

///|
fn write_parts_group_enum(
  out : StringBuilder,
  group : String,
  entries : Array[Entry],
  schema : Schema,
) -> Unit {
  out.write_string(
    "///|\n/// Rich messages in the `\{group}` group.\npub(all) enum \{pascal(group)}Parts {\n",
  )
  for entry in entries {
    write_entry_doc(out, schema, entry)
    out.write_string("  \{pascal(entry.key)}")
    if !entry.params.is_empty() {
      out.write_string("(\{join_param_types(entry.params)})")
    }
    out.write_string("\n")
  }
  out.write_string("} derive(Eq, Debug)\n\n")
}

///|
fn write_entry_doc(out : StringBuilder, schema : Schema, entry : Entry) -> Unit {
  let id = message_id(entry)
  let description = match schema_description(schema, id) {
    Some(value) if !value.trim().is_empty() => value
    _ => "Message `\{id}`."
  }
  out.write_string("  /// \{documentation_text(description)}\n")
}

///|
fn documentation_text(text : String) -> String {
  let out = StringBuilder::new()
  for char in text.trim().to_array() {
    let code = char.to_int()
    if code < 0x20 || code == 0x7f || code == 0x2028 || code == 0x2029 {
      out.write_char(' ')
    } else {
      out.write_char(char)
    }
  }
  out.to_string()
}

///|
fn write_message_id(out : StringBuilder, entries : Array[Entry]) -> Unit {
  out.write_string(
    "///|\nfn message_id(text : I18nText) -> String {\n  match text {\n",
  )
  for group in groups(entries) {
    out.write_string("    \{pascal(group)}(key) => match key {\n")
    for entry in entries_for(entries, group) {
      if entry.params.is_empty() {
        out.write_string(
          "      \{pascal(entry.key)} => \"\{message_id(entry)}\"\n",
        )
      } else {
        out.write_string(
          "      \{pascal(entry.key)}(\{join_param_wildcards(entry.params)}) => \"\{message_id(entry)}\"\n",
        )
      }
    }
    out.write_string("    }\n")
  }
  out.write_string("  }\n}\n\n")
}

///|
fn write_parts_message_id(out : StringBuilder, entries : Array[Entry]) -> Unit {
  out.write_string(
    "///|\nfn parts_message_id(text : I18nParts) -> String {\n  match text {\n",
  )
  for group in groups(entries) {
    out.write_string("    \{pascal(group)}(key) => match key {\n")
    for entry in entries_for(entries, group) {
      if entry.params.is_empty() {
        out.write_string(
          "      \{pascal(entry.key)} => \"\{message_id(entry)}\"\n",
        )
      } else {
        out.write_string(
          "      \{pascal(entry.key)}(\{join_param_wildcards(entry.params)}) => \"\{message_id(entry)}\"\n",
        )
      }
    }
    out.write_string("    }\n")
  }
  out.write_string("  }\n}\n\n")
}

///|
fn write_message_args(out : StringBuilder, entries : Array[Entry]) -> Unit {
  out.write_string(
    "///|\nfn message_args(text : I18nText) -> Array[@runtime.MessageArg] {\n  match text {\n",
  )
  for group in groups(entries) {
    let group_entries = entries_for(entries, group)
    if group_entries.all(entry => entry.params.is_empty()) {
      out.write_string("    \{pascal(group)}(_) => []\n")
    } else {
      out.write_string("    \{pascal(group)}(key) => match key {\n")
      for entry in group_entries {
        if entry.params.is_empty() {
          out.write_string("      \{pascal(entry.key)} => []\n")
        } else {
          out.write_string(
            "      \{pascal(entry.key)}(\{join_param_names(entry.params)}) => [\n",
          )
          for param in entry.params {
            out.write_string(
              "        { name: \"\{param.name}\", value: @runtime.\{value_constructor(param.typ)}(\{param.name}) },\n",
            )
          }
          out.write_string("      ]\n")
        }
      }
      out.write_string("    }\n")
    }
  }
  out.write_string("  }\n}\n\n")
}

///|
fn write_parts_message_args(
  out : StringBuilder,
  entries : Array[Entry],
) -> Unit {
  out.write_string(
    "///|\nfn parts_message_args(text : I18nParts) -> Array[@runtime.MessageArg] {\n  match text {\n",
  )
  for group in groups(entries) {
    let group_entries = entries_for(entries, group)
    if group_entries.all(entry => entry.params.is_empty()) {
      out.write_string("    \{pascal(group)}(_) => []\n")
    } else {
      out.write_string("    \{pascal(group)}(key) => match key {\n")
      for entry in group_entries {
        if entry.params.is_empty() {
          out.write_string("      \{pascal(entry.key)} => []\n")
        } else {
          out.write_string(
            "      \{pascal(entry.key)}(\{join_param_names(entry.params)}) => [\n",
          )
          for param in entry.params {
            out.write_string(
              "        { name: \"\{param.name}\", value: @runtime.\{value_constructor(param.typ)}(\{param.name}) },\n",
            )
          }
          out.write_string("      ]\n")
        }
      }
      out.write_string("    }\n")
    }
  }
  out.write_string("  }\n}\n\n")
}

///|
fn write_embedded_catalogs(
  out : StringBuilder,
  config : I18nConfig,
  locales : Array[LocaleResource],
) -> Unit {
  out.write_string(
    "///|\nfn embedded_catalogs() -> Array[@runtime.Catalog] {\n  [\n",
  )
  for code in config.embedded_locales {
    match find_locale(locales, code) {
      Some(locale) => {
        out.write_string(
          "    @runtime.Catalog::from_generated_entries(locale_code=\"\{code}\", contract_hash=CONTRACT_HASH, direction=\"\{locale_direction(config, code)}\", entries=[\n",
        )
        for entry in locale.entries {
          out.write_string(
            "      { id: \"\{message_id(entry)}\", message: \"\{escape_text(entry.text)}\" },\n",
          )
        }
        out.write_string("    ]),\n")
      }
      None => ()
    }
  }
  out.write_string("  ]\n}\n\n")
}

///|
fn write_facade(
  out : StringBuilder,
  config : I18nConfig,
  has_text : Bool,
  has_parts : Bool,
) -> Unit {
  let facade =
    #|///|
    #|/// Generated application i18n facade with installed catalogs and caches.
    #|pub struct I18n {
    #|  runtime : @runtime.I18n
    #|}
    #|
    #|///|
    #|/// Locale-bound typed translation facade.
    #|pub struct Translator {
    #|  runtime : @runtime.Translator
    #|}
    #|
    #|///|
    #|/// Creates the application facade and installs all embedded catalogs.
    #|pub fn I18n::new() -> I18n {
    #|  let runtime = @runtime.I18n::new(
    #|    fallback_locale_code=fallback_locale().code(),
    #|    contract_hash=CONTRACT_HASH,
    #|    formatter=@runtime_js.formatter(),
    #|  )
    #|  for catalog in embedded_catalogs() {
    #|    match runtime.install_generated_catalog(catalog) {
    #|      Ok(_) => ()
    #|      Err(message) => abort("invalid embedded i18n catalog: \{message}")
    #|    }
    #|  }
    #|  { runtime, }
    #|}
    #|
    #|///|
    #|/// Creates a translator for the configured default locale.
    #|pub fn I18n::default_translator(self : I18n) -> Translator {
    #|  self.translator(default_locale())
    #|}
    #|
    #|///|
    #|/// Creates a translator for one supported locale.
    #|pub fn I18n::translator(self : I18n, locale : Locale) -> Translator {
    #|  { runtime: self.runtime.translator(locale.code()) }
    #|}
    #|
    #|///|
    #|/// Resolves one external locale code and creates its translator.
    #|pub fn I18n::translator_from_code(
    #|  self : I18n,
    #|  code : String,
    #|) -> Translator {
    #|  self.translator_from_codes([code])
    #|}
    #|
    #|///|
    #|/// Negotiates ordered external locale codes and creates a translator.
    #|pub fn I18n::translator_from_codes(
    #|  self : I18n,
    #|  codes : Array[String],
    #|) -> Translator {
    #|  self.translator(resolve_locale_codes(codes))
    #|}
    #|
    #|///|
    #|/// Negotiates ordered external locale codes against supported locales.
    #|pub fn resolve_locale_codes(codes : Array[String]) -> Locale {
    #|  let supported = all_locales().map(locale => locale.code())
    #|  let resolved = @runtime.resolve_locale_code(
    #|    codes,
    #|    supported,
    #|    default_locale().code(),
    #|  )
    #|  locale_from_code(resolved, default_locale())
    #|}
    #|
    #|///|
    #|/// Validates and installs dynamic catalog-v2 JSON for a locale.
    #|pub fn I18n::install_catalog_source(
    #|  self : I18n,
    #|  locale : Locale,
    #|  source : String,
    #|) -> Result[Unit, String] {
    #|  self.runtime.install_catalog_source_for(locale.code(), source)
    #|}
    #|
    #|///|
    #|/// Reports whether a catalog is currently installed for a locale.
    #|pub fn I18n::has_catalog(self : I18n, locale : Locale) -> Bool {
    #|  self.runtime.has_catalog(locale.code())
    #|}
    #|
    #|///|
    #|/// Returns all locales whose catalogs are currently installed.
    #|pub fn I18n::installed_locales(self : I18n) -> Array[Locale] {
    #|  self.runtime.catalog_locale_codes().map(code => {
    #|    locale_from_code(code, fallback_locale())
    #|  })
    #|}
    #|
    #|///|
    #|/// Drains bounded, deduplicated translation diagnostics.
    #|pub fn I18n::take_diagnostics(self : I18n) -> @runtime.DiagnosticBatch {
    #|  self.runtime.take_diagnostics()
    #|}
    #|
    #|///|
    #|/// Returns the locale bound to this translator.
    #|pub fn Translator::locale(self : Translator) -> Locale {
    #|  locale_from_code(self.runtime.locale_code(), default_locale())
    #|}
    #|
    #|///|
    #|fn all_locales() -> Array[Locale] {
    #|  [
  out.write_string(facade)
  // Locale negotiation uses the declared locale set even before a dynamic
  // catalog has been installed.
  for locale in config.locales {
    out.write_string("    \{locale_variant(locale.code)},\n")
  }
  out.write_string("  ]\n}\n\n")
  if has_text {
    out.write_string(
      (
        #|///|
        #|/// Strictly formats a typed text request and returns structured failures.
        #|pub fn Translator::try_t(
        #|  self : Translator,
        #|  text : I18nText,
        #|) -> Result[String, @runtime.TranslationError] {
        #|  self.runtime.try_t(message_id(text), message_args(text))
        #|}
        #|
        #|///|
        #|/// Formats a typed text request with observable fallback diagnostics.
        #|pub fn Translator::t(self : Translator, text : I18nText) -> String {
        #|  self.runtime.t(message_id(text), message_args(text))
        #|}
        #|
      ),
    )
  }
  if has_parts {
    out.write_string(
      (
        #|///|
        #|/// Strictly formats a typed rich request as structured markup parts.
        #|pub fn Translator::try_t_parts(
        #|  self : Translator,
        #|  text : I18nParts,
        #|) -> Result[Array[@runtime.MessagePart], @runtime.TranslationError] {
        #|  self.runtime.try_t_parts(parts_message_id(text), parts_message_args(text))
        #|}
        #|
        #|///|
        #|/// Formats a typed rich request with observable fallback diagnostics.
        #|pub fn Translator::t_parts(
        #|  self : Translator,
        #|  text : I18nParts,
        #|) -> Array[@runtime.MessagePart] {
        #|  self.runtime.t_parts(parts_message_id(text), parts_message_args(text))
        #|}
        #|
      ),
    )
  }
}

///|
fn find_locale(
  locales : Array[LocaleResource],
  code : String,
) -> LocaleResource? {
  for locale in locales {
    if locale.locale == code {
      return Some(locale)
    }
  }
  None
}

///|
fn locale_direction(config : I18nConfig, code : String) -> String {
  match find_locale_config(config.locales, code) {
    Some(locale) => locale.direction
    None => "ltr"
  }
}

///|
fn join_param_types(params : Array[Param]) -> String {
  params.map(param => moonbit_param_type(param.typ)).join(", ")
}

///|
fn join_param_names(params : Array[Param]) -> String {
  params.map(param => param.name).join(", ")
}

///|
fn join_param_wildcards(params : Array[Param]) -> String {
  params.map(_ => "_").join(", ")
}

///|
fn value_constructor(typ : String) -> String {
  match typ {
    "String" => "TextValue"
    "Int" => "IntValue"
    "Double" => "DoubleValue"
    "Bool" => "BoolValue"
    "InstantMillis" => "InstantMillis"
    _ => "TextValue"
  }
}

///|
fn moonbit_param_type(typ : String) -> String {
  if typ == "InstantMillis" {
    "Int64"
  } else {
    typ
  }
}

///|
fn escape_text(text : String) -> String {
  let out = StringBuilder::new()
  for char in text.to_array() {
    match char {
      '\\' => out.write_string("\\\\")
      '"' => out.write_string("\\\"")
      '\n' => out.write_string("\\n")
      '\r' => out.write_string("\\r")
      '\t' => out.write_string("\\t")
      _ =>
        if char.to_int() < 0x20 ||
          char == '\u{7f}' ||
          char == '\u{2028}' ||
          char == '\u{2029}' {
          out.write_string("\\u{")
          out.write_string(char.to_int().to_string(radix=16))
          out.write_char('}')
        } else {
          out.write_char(char)
        }
    }
  }
  out.to_string()
}
