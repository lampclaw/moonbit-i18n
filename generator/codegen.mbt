///|
pub fn generate_bindings(
  config : I18nConfig,
  schema : Schema,
  locales : Array[LocaleResource],
  schema_hash : String,
) -> String {
  let out = StringBuilder::new()
  out.write_string("// Generated by lampclaw/i18n. Do not edit by hand.\n\n")
  out.write_string(
    "///|\npub const SCHEMA_HASH : String = \"\{escape_text(schema_hash)}\"\n\n",
  )
  write_locale_enum(out, config)
  write_i18n_text_enum(out, schema.entries)
  for group in groups(schema.entries) {
    write_group_enum(out, group, entries_for(schema.entries, group))
  }
  write_message_id(out, schema)
  write_message_args(out, schema)
  write_embedded_catalogs(out, config, locales)
  out.to_string()
}

///|
fn write_locale_enum(out : StringBuilder, config : I18nConfig) -> Unit {
  out.write_string("///|\npub(all) enum Locale {\n")
  for locale in config.locales {
    out.write_string("  \{locale_variant(locale.code)}\n")
  }
  out.write_string("} derive(Eq, Debug)\n\n")
  out.write_string(
    "///|\npub fn Locale::code(self : Locale) -> String {\n  match self {\n",
  )
  for locale in config.locales {
    out.write_string(
      "    \{locale_variant(locale.code)} => \"\{locale.code}\"\n",
    )
  }
  out.write_string("  }\n}\n\n")
  out.write_string(
    "///|\npub fn Locale::html_lang(self : Locale) -> String { self.code() }\n\n",
  )
  out.write_string(
    "///|\npub fn Locale::direction(self : Locale) -> String {\n  match self {\n",
  )
  for locale in config.locales {
    out.write_string(
      "    \{locale_variant(locale.code)} => \"\{locale.direction}\"\n",
    )
  }
  out.write_string("  }\n}\n\n")
  out.write_string(
    "///|\npub fn default_locale() -> Locale { \{locale_variant(config.default_locale)} }\n\n",
  )
  out.write_string(
    "///|\npub fn fallback_locale() -> Locale { \{locale_variant(config.fallback_locale)} }\n\n",
  )
  out.write_string(
    "///|\npub fn locale_from_code(code : String, fallback : Locale) -> Locale {\n",
  )
  out.write_string(
    "  match @runtime.normalize_locale_code(code) {\n    Ok(code) => match code {\n",
  )
  for locale in config.locales {
    out.write_string(
      "      \"\{locale.code}\" => \{locale_variant(locale.code)}\n",
    )
  }
  out.write_string(
    "      _ => fallback\n    }\n    Err(_) => fallback\n  }\n}\n\n",
  )
}

///|
fn write_i18n_text_enum(out : StringBuilder, entries : Array[Entry]) -> Unit {
  out.write_string("///|\npub(all) enum I18nText {\n")
  for group in groups(entries) {
    let type_name = pascal(group)
    out.write_string("  \{type_name}(\{type_name}Text)\n")
  }
  out.write_string("} derive(Eq, Debug)\n\n")
}

///|
fn write_group_enum(
  out : StringBuilder,
  group : String,
  entries : Array[Entry],
) -> Unit {
  out.write_string("///|\npub(all) enum \{pascal(group)}Text {\n")
  for entry in entries {
    out.write_string("  \{pascal(entry.key)}")
    if !entry.params.is_empty() {
      out.write_string("(\{join_param_types(entry.params)})")
    }
    out.write_string("\n")
  }
  out.write_string("} derive(Eq, Debug)\n\n")
}

///|
fn write_message_id(out : StringBuilder, schema : Schema) -> Unit {
  out.write_string(
    "///|\nfn message_id(text : I18nText) -> String {\n  match text {\n",
  )
  for group in groups(schema.entries) {
    out.write_string("    \{pascal(group)}(key) => match key {\n")
    for entry in entries_for(schema.entries, group) {
      if entry.params.is_empty() {
        out.write_string(
          "      \{pascal(entry.key)} => \"\{message_id(entry)}\"\n",
        )
      } else {
        out.write_string(
          "      \{pascal(entry.key)}(\{join_param_wildcards(entry.params)}) => \"\{message_id(entry)}\"\n",
        )
      }
    }
    out.write_string("    }\n")
  }
  out.write_string("  }\n}\n\n")
}

///|
fn write_message_args(out : StringBuilder, schema : Schema) -> Unit {
  out.write_string(
    "///|\nfn message_args(text : I18nText) -> Array[@runtime.MessageArg] {\n  match text {\n",
  )
  for group in groups(schema.entries) {
    let entries = entries_for(schema.entries, group)
    if entries.all(entry => entry.params.is_empty()) {
      out.write_string("    \{pascal(group)}(_) => []\n")
    } else {
      out.write_string("    \{pascal(group)}(key) => match key {\n")
      for entry in entries {
        if entry.params.is_empty() {
          out.write_string("      \{pascal(entry.key)} => []\n")
        } else {
          out.write_string(
            "      \{pascal(entry.key)}(\{join_param_names(entry.params)}) => [\n",
          )
          for param in entry.params {
            out.write_string(
              "        { name: \"\{param.name}\", value: @runtime.\{value_constructor(param.typ)}(\{param.name}) },\n",
            )
          }
          out.write_string("      ]\n")
        }
      }
      out.write_string("    }\n")
    }
  }
  out.write_string("  }\n}\n\n")
}

///|
fn write_embedded_catalogs(
  out : StringBuilder,
  config : I18nConfig,
  locales : Array[LocaleResource],
) -> Unit {
  out.write_string(
    "///|\nfn embedded_catalogs() -> Array[@runtime.Catalog] {\n  [\n",
  )
  for code in config.embedded_locales {
    match find_locale(locales, code) {
      Some(locale) => {
        out.write_string(
          "    @runtime.Catalog::new(locale_code=\"\{code}\", schema_hash=SCHEMA_HASH, direction=\"\{locale_direction(config, code)}\", entries=[\n",
        )
        for entry in locale.entries {
          out.write_string(
            "      { id: \"\{message_id(entry)}\", message: \"\{escape_text(entry.text)}\" },\n",
          )
        }
        out.write_string("    ]),\n")
      }
      None => ()
    }
  }
  out.write_string("  ]\n}\n")
}

///|
fn find_locale(
  locales : Array[LocaleResource],
  code : String,
) -> LocaleResource? {
  for locale in locales {
    if locale.locale == code {
      return Some(locale)
    }
  }
  None
}

///|
fn locale_direction(config : I18nConfig, code : String) -> String {
  match find_locale_config(config.locales, code) {
    Some(locale) => locale.direction
    None => "ltr"
  }
}

///|
fn join_param_types(params : Array[Param]) -> String {
  params.map(param => moonbit_param_type(param.typ)).join(", ")
}

///|
fn join_param_names(params : Array[Param]) -> String {
  params.map(param => param.name).join(", ")
}

///|
fn join_param_wildcards(params : Array[Param]) -> String {
  params.map(_ => "_").join(", ")
}

///|
fn value_constructor(typ : String) -> String {
  match typ {
    "String" => "TextValue"
    "Int" => "IntValue"
    "Double" => "DoubleValue"
    "Bool" => "BoolValue"
    "DateTime" => "DateTimeValue"
    _ => "TextValue"
  }
}

///|
fn moonbit_param_type(typ : String) -> String {
  if typ == "DateTime" {
    "String"
  } else {
    typ
  }
}

///|
fn escape_text(text : String) -> String {
  let out = StringBuilder::new()
  for char in text.to_array() {
    match char {
      '\\' => out.write_string("\\\\")
      '"' => out.write_string("\\\"")
      '\n' => out.write_string("\\n")
      '\r' => out.write_string("\\r")
      '\t' => out.write_string("\\t")
      _ => out.write_char(char)
    }
  }
  out.to_string()
}
